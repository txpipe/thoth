  "author": "TxPipe-Shop",
  "keywords": [
    "thoth",
    "midnight",
    "attestation",
    "zero-knowledge",
    "zk",
    "zkfetch",
    "reclaim"
  ],
  "homepage": "https://github.com/txpipe-shop/thoth#readme",
  "bugs": {
    "url": "https://github.com/txpipe-shop/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe-shop/thoth.git",
    "directory": "packages/zk-tls"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./attestor": {
      "types": "./dist/attestor/index.d.ts",
      "import": "./dist/attestor/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js"
    },
    "./prover": {
      "types": "./dist/prover/index.d.ts",
      "import": "./dist/prover/index.js"
    },
    "./thoth": {
      "types": "./dist/thoth/index.d.ts",
      "import": "./dist/thoth/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "types": "tsc --noEmit",
    "witnesses": "bash scripts/start-witnesses.sh"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@reclaimprotocol/attestor-core": "5.1.6",
