    "re2": "1.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
