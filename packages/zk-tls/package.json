{
  "name": "@txpipe/thoth-zk-tls",
  "version": "0.0.0",
  "description": "zkFetch attestor kind for the Thoth N-of-M attestation system.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "TxPipe-Shop",
  "keywords": [
    "thoth",
    "midnight",
    "attestation",
    "zero-knowledge",
    "zk",
    "zkfetch",
    "reclaim"
  ],
  "homepage": "https://github.com/txpipe-shop/thoth#readme",
  "bugs": {
    "url": "https://github.com/txpipe-shop/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe-shop/thoth.git",
    "directory": "packages/zk-tls"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./attestor": {
      "types": "./dist/attestor/index.d.ts",
      "import": "./dist/attestor/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./prover": {
      "types": "./dist/prover/index.d.ts",
      "import": "./dist/prover/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "types": "tsc --noEmit",
    "witnesses": "bash scripts/start-witnesses.sh"
  },
  "dependencies": {
    "@reclaimprotocol/attestor-core": "5.1.6",
    "@reclaimprotocol/tls": "0.1.5",
    "@txpipe/thoth-attestor": "^0.0.0",
    "@txpipe/thoth-client": "^0.0.0",
    "@txpipe/thoth-core": "^0.0.0",
    "re2": "1.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
