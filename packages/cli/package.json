{
  "name": "@thoth/cli",
  "version": "0.0.0",
  "description": "The thoth CLI: generates a Midnight app's Thoth embedding from one config file.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "TxPipe-Shop",
  "keywords": [
    "thoth",
    "midnight",
    "attestation",
    "zero-knowledge",
    "zk",
    "cli"
  ],
  "homepage": "https://github.com/txpipe-shop/thoth#readme",
  "bugs": {
    "url": "https://github.com/txpipe-shop/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe-shop/thoth.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "thoth": "./dist/bin.js"
  },
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@thoth/core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@thoth/client": "*",
    "@thoth/zk-tls": "*",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
