{
  "name": "@txpipe/thoth-cardano",
  "version": "0.0.0",
  "description": "cardano@1 chain-event attestor kind for the Thoth N-of-M attestation system.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "TxPipe-Shop",
  "keywords": [
    "thoth",
    "midnight",
    "attestation",
    "zero-knowledge",
    "zk",
    "cardano"
  ],
  "homepage": "https://github.com/txpipe-shop/thoth#readme",
  "bugs": {
    "url": "https://github.com/txpipe-shop/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe-shop/thoth.git",
    "directory": "packages/cardano"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./attestor": {
      "types": "./dist/attestor/index.d.ts",
      "import": "./dist/attestor/index.js",
      "default": "./dist/attestor/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./dolos": {
      "types": "./dist/dolos/index.d.ts",
      "import": "./dist/dolos/index.js",
      "default": "./dist/dolos/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@txpipe/thoth-attestor": "^0.0.0",
    "@txpipe/thoth-client": "^0.0.0",
    "@txpipe/thoth-core": "^0.0.0",
    "@utxorpc/sdk": "^0.9.0",
    "@utxorpc/spec": "^0.19.2",
    "bech32": "^2.0.0"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
