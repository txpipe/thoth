{
  "name": "@txpipe/thoth-client",
  "version": "0.0.0",
  "description": "Client-facing types for the Thoth N-of-M attestation system.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "TxPipe",
  "keywords": [
    "thoth",
    "midnight",
    "attestation",
    "zero-knowledge",
    "zk"
  ],
  "homepage": "https://github.com/txpipe/thoth#readme",
  "bugs": {
    "url": "https://github.com/txpipe/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/txpipe/thoth.git",
    "directory": "packages/client"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./jubjub": {
      "types": "./dist/jubjub.d.ts",
      "import": "./dist/jubjub.js",
      "default": "./dist/jubjub.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@txpipe/thoth-core": "^0.0.0"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
