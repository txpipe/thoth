// Thoth attestation module: verifies an N-of-M attested `Claim`, rejects
// claims for another app, replays and out-of-window claims, and vaults it under
// its nullifier. The registry checks the #N signatures the prover supplies,
// each against the key of the slot it names; this module defines the message.
//
// Wire layout (buildMessage): attestors sign seven fields,
//   [ version, V as Field, W as Field,
//     nullifier[31], nullifier[0..31],
//     holder[31], holder[0..31] ]
// A 32-byte value is two fields: byte 31, then bytes 0-30 read little-endian
// (byte 0 least significant, the runtime's `convertBytesToUint` convention).
// Byte ranges are half-open (holder[0..31] is bytes 0-30). Both fit a Field
// without wraparound, so the pair is injective.
// The nullifier is the SHA-256 (`persistentHash<Observation>`) of the
// observation identity, 136 + 9*V + 33*W bytes in this order:
//   appId (32), policyHash (32), subjectHash (32), salt (32),
//   windowStart (4), windowEnd (4),
//   values[0], ..., values[V-1] (8 each),
//   byteValues[0], ..., byteValues[W-1] (32 each),
//   present[0], ..., present[V-1] (1 each),
//   bytePresent[0], ..., bytePresent[W-1] (1 each)
// Integers are little-endian at their width; a Boolean is one byte, 0 or 1.
// `version` and `holder` reach the message directly, every other claim field
// through the nullifier. So a change to the observation identity changes what
// attestors sign, and a new identity ships under a new version. `claimToMessage`
// and `nullifierOf` in `@txpipe/thoth-core/claim` mirror this.
// The message carries V and W because the identity's length fixes only
// 9*V + 33*W: two layouts (V=11, W=0 and V=0, W=3) can serialize to the same
// bytes, and a message signed under one must fail verification under the
// other. The sealed appId does not separate them: every contract of one app
// seals the same one.
//
// Module parameters (import "attestation"<V, W, N, M>), fixed when a
// contract embeds the module:
//   #V — number of numeric value slots (Claim.values: Vector<V, Uint<64>>).
//   #W — number of byte slots (Claim.byteValues: Vector<W, Bytes<32>>), the
//        client's byteSlots. W = 0 is the numeric-only layout.
//   #N — the threshold: `getSignatures` supplies exactly #N signatures, each
//        named by a distinct registry slot, and every one must verify.
//   #M — number of registry slots, the registry's key count.
pragma language_version >= 0.22;

module attestation<#V, #W, #N, #M> {
  import CompactStandardLibrary;
  import "attestor_registry"<M> prefix Registry_;

  export struct ClaimEntry {
    holder: Field;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
  }

  export struct Claim {
    version: Uint<8>; // wire version (1)
    appId: Bytes<32>; // the app the claim is for
    policyHash: Bytes<32>; // hash of the policy the attestors enforced
    windowStart: Uint<32>; // Unix seconds the attestor's observation began (ADR 0005)
    windowEnd: Uint<32>; // Unix seconds the attestor's observation ended
    subjectHash: Bytes<32>; // circuit hash of what the claim is about (ADR 0001)
    holder: Bytes<32>; // per-claim commitment of the caller secret (ADR 0004)
    salt: Bytes<32>; // secret the attestors derive from the evidence; keys the nullifier (ADR 0012)
    present: Vector<V, Boolean>; // present[i] = values[i] was measured, even if 0
    bytePresent: Vector<W, Boolean>; // bytePresent[i] = byteValues[i] was measured, even if all zero
    values: Vector<V, Uint<64>>; // positional numeric values; 0 is a valid measured value
    byteValues: Vector<W, Bytes<32>>; // positional 32-byte values, zero-padded
  }

  /// The observation identity: what the nullifier hashes and what `openClaim`
  /// returns. Holder and version are not hashed directly; the holder reaches
  /// it only through the kind's salt. A secret salt keeps the public nullifier
  /// from confirming guessed values. The attestors sign its hash, so
  /// reordering, adding or retyping a field changes what they sign.
  export struct Observation {
    appId: Bytes<32>;
    policyHash: Bytes<32>;
    subjectHash: Bytes<32>;
    salt: Bytes<32>;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
    values: Vector<V, Uint<64>>;
    byteValues: Vector<W, Bytes<32>>;
    present: Vector<V, Boolean>;
    bytePresent: Vector<W, Boolean>;
  }

  // 22 tag bytes keep the preimage at 54 bytes, one SHA-256 block: a block
  // holds at most 55 input bytes after padding, and a second block costs the
  // circuit about 1,850 rows.
  struct HolderPreimage {
    tag: Bytes<22>;
    secret: Bytes<32>;
  }

  /// The app this contract accepts claims for, sealed by the top-level
  /// constructor (ADR 0013).
  export sealed ledger appId: Bytes<32>;
  /// Seconds after `windowEnd` a claim stays submittable, sealed by the
  /// top-level constructor. 0 does not disable the check: the claim must then
  /// land inside its window.
  export sealed ledger freshnessWindow: Uint<64>;
  /// Longest accepted observation window in seconds, sealed by the top-level
  /// constructor.
  export sealed ledger maxWindow: Uint<64>;
  /// Accepted policy hashes, sealed by the top-level constructor (ADR 0008).
  export sealed ledger policyHashes: Set<Bytes<32>>;
  /// Accepted claims, keyed by their nullifier. A key present here is an
  /// observation already accepted, so membership is the replay check.
  export ledger claimsVault: Map<Bytes<32>, ClaimEntry>;

  witness getAttestationWitness(): Claim;
  // A witness of its own, so `openClaim` does not take signature inputs it
  // never reads.
  witness getSignatures(): Vector<N, Registry_SlotSignature>;
  witness getHolderSecret(): Bytes<32>;

  /// The vault pseudonym of a holder secret: hashToCurve over the
  /// domain-separated secret.
  circuit deriveHolder(secret: Bytes<32>): Field {
    return jubjubPointX(hashToCurve<Vector<2, Bytes<32>>>([pad(32, "thoth:holder:v1"), secret]));
  }

  /// A 32-byte value as two message fields: byte 31, then bytes 0-30 read
  /// little-endian. A circuit already holds 32 bytes this way, so the split
  /// needs no byte-by-byte decomposition, unlike a cut at byte 16.
  circuit limbs(b: Bytes<32>): Vector<2, Field> {
    return [slice<1>(b, 31) as Field, degradeToTransient(b)];
  }

  circuit messageOf(version: Uint<8>, nullifier: Bytes<32>, holder: Bytes<32>): Vector<7, Field> {
    const n = limbs(nullifier);
    const h = limbs(holder);
    return [version as Field, V as Field, W as Field, n[0], n[1], h[0], h[1]];
  }

  /// The signed message, per the wire layout in the file header: the claim's
  /// version, this contract's layout, the claim's nullifier and its holder.
  export pure circuit buildMessage(c: Claim): Vector<7, Field> {
    return messageOf(c.version, nullifierOf(c), c.holder);
  }

  /// The vault pseudonym of a holder secret. Exported pure so tests can
  /// reproduce it.
  export pure circuit holderOf(secret: Bytes<32>): Field {
    return deriveHolder(secret);
  }

  /// The per-claim holder commitment: SHA-256 of the 22-byte tag
  /// `thoth:holder-commit:v1`, then the secret. It is a different function
  /// from `deriveHolder`, so one secret yields unrelated values in the two
  /// roles. Exported pure so `holderCommitmentOf` in
  /// `@txpipe/thoth-core/claim-context` can match it.
  export pure circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentHash<HolderPreimage>(
             HolderPreimage { tag: pad(22, "thoth:holder-commit:v1"), secret: secret }
             );
  }

  circuit observationOf(claim: Claim): Observation {
    return Observation { appId: claim.appId,
                         policyHash: claim.policyHash,
                         subjectHash: claim.subjectHash,
                         salt: claim.salt,
                         windowStart: claim.windowStart,
                         windowEnd: claim.windowEnd,
                         values: claim.values,
                         byteValues: claim.byteValues,
                         present: claim.present,
                         bytePresent: claim.bytePresent };
  }

  /// The nullifier the attestors sign and the claims vault is keyed by: the
  /// SHA-256 of the claim's observation identity, whose preimage the file
  /// header gives. Exported pure so `nullifierOf` in `@txpipe/thoth-core/claim`
  /// can match it.
  export pure circuit nullifierOf(claim: Claim): Bytes<32> {
    return persistentHash<Observation>(observationOf(claim));
  }

  /// Verify an attested claim and store it in the claims vault.
  export circuit verifyAttestation(): [] {
    const claim = getAttestationWitness();
    assert(claim.version == 1, "Unsupported claim version");
    assert(claim.appId == appId, "App id mismatch");
    assert(policyHashes.member(disclose(claim.policyHash)), "Unaccepted policy");

    // One hash of the claim serves the signatures, the replay check and the
    // vault key.
    const nullifier = nullifierOf(claim);
    const msg = messageOf(claim.version, nullifier, claim.holder);
    Registry_requireSignatures<N>(msg, getSignatures());

    const validSlots =
            map((present: Boolean, value: Uint<64>) => present || value == 0,
                claim.present,
                claim.values);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validSlots),
           "Absent slot has nonzero value"
           );

    const zeroBytes = pad(32, "");
    const validByteSlots =
            map((present: Boolean, value: Bytes<32>) => present || value == zeroBytes,
                claim.bytePresent,
                claim.byteValues);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validByteSlots),
           "Absent slot has nonzero value"
           );

    assert(claim.windowStart <= claim.windowEnd, "Window inverted");
    assert(claim.windowEnd - claim.windowStart <= maxWindow, "Window too long");
    assert(blockTimeGte(disclose(claim.windowStart as Uint<64>)), "Window in the future");
    assert(blockTimeLt(disclose((claim.windowEnd + freshnessWindow) as Uint<64>)), "Window too old");

    const secret = getHolderSecret();
    assert(claim.holder == holderCommitment(secret), "Holder mismatch");

    assert(!claimsVault.member(disclose(nullifier)), "Observation replay");
    claimsVault.insert(
      disclose(nullifier),
      ClaimEntry { holder: disclose(deriveHolder(secret)),
                   windowStart: disclose(claim.windowStart),
                   windowEnd: disclose(claim.windowEnd) }
      );
  }

  /// Prove the caller owns the claim vaulted under `nullifier` and return its
  /// observation identity for in-circuit predicates (byte value `i` is
  /// `o.byteValues[i]`, compared to a `Bytes<32>` directly). It returns
  /// only the fields the nullifier binds, not `holder` or `version`, which the
  /// nullifier does not cover and this circuit does not check.
  /// Consumes nothing, so opening is repeatable: "use once" is the app's own
  /// state. Never re-export it as a top-level entry point: its return value is
  /// tainted and would force a disclose that reveals every value.
  export circuit openClaim(nullifier: Bytes<32>): Observation {
    const claim = getAttestationWitness();
    const key = disclose(nullifier);
    assert(claimsVault.member(key), "Unknown claim");
    assert(claimsVault.lookup(key).holder == disclose(deriveHolder(getHolderSecret())),
           "Claim not bound to caller"
           );
    const observation = observationOf(claim);
    assert(persistentHash<Observation>(observation) == key, "Claim does not match nullifier");
    return observation;
  }
}
