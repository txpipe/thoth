// Thoth Attestation module.
//
// Verifies an off-chain attested `Claim` against an N-of-M attestor
// signature threshold, controls replay and (optionally) freshness, and stores
// a claimsVault entry keyed by `persistentCommit(claim, rand)`.
//
// Responsibilities:
//   - verify >= #N of #M signatures from the appended AttestorRegistry over the
//     frozen flat message built by `buildMessage` (this module's contract law);
//   - reject a claim attested under another policy than the sealed
//     `policyDigest`;
//   - reject a claim whose holder commitment isn't derived from the caller's
//     holder secret (`holderCommitment`);
//   - reject an inverted window, a window longer than the sealed `maxWindow`,
//     and a window that doesn't contain the block time: the block time must be
//     at least `windowStart` and earlier than `windowEnd + freshnessWindow`;
//   - reject nonce replay via the nullifiers set;
//   - store { holder, timestamp = windowEnd } in the claimsVault; windowStart and
//     windowEnd + freshnessWindow are disclosed to the block-time checks. Nothing is returned:
//     the app composes its own predicates over the claim via `openClaim`.
//
// Signature counting is delegated to the registry; the threshold decision
// (#N) lives here. The message shape (order+sizes) is the single thing the
// attestor must mirror, per the documented wire layout below.
//
// Module parameters (import "attestation"<K, V, N, M>):
//   #K — signed-message length in fields. Must equal 2*V + 8 (the 8-field
//        header in buildMessage, the V `present` fields, and the V value
//        fields). This is what the registry's countValidSignatures verifies
//        over.
//   #V — number of claim value slots (Claim.values: Vector<V, Uint<64>>).
//   #N — the app's N-of-M threshold: at least #N of the #M signatures must
//        verify for a claim to be accepted.
//   #M — number of attestor signatures supplied / registry key slots.
// All parameters are fixed when a contract embeds the module.
pragma language_version >= 0.22;

module attestation<#K, #V, #N, #M> {
  import CompactStandardLibrary;
  import "schnorr" prefix Schnorr_;
  import "attestor_registry"<M, K> prefix Registry_;

  export struct ClaimEntry {
    holder: Field;
    timestamp: Uint<32>;
  }

  export struct Claim {
    version: Uint<8>; // schema version (1)
    kind: Uint<8>; // attestor kind (1 = reclaim-attestor)
    policyDigest: Bytes<32>; // SHA-256 of the policy the claim was attested under
    requestBinding: Bytes<32>; // SHA-256 of the certified request identity
    holder: Bytes<32>; // holder commitment the claim is bound to
    nonce: Bytes<32>; // operation nonce (replay protection)
    windowStart: Uint<32>; // observation window start, Unix seconds
    windowEnd: Uint<32>; // observation window end, Unix seconds
    present: Vector<V, Boolean>; // present[i] = values[i] was populated (measured), even if 0
    values: Vector<V, Uint<64>>; // positional numeric claim values last; 0 IS a valid value
  }

  /// Freshness window (seconds), sealed at deploy by the top-level
  /// constructor: a claim is accepted until `windowEnd + freshnessWindow`.
  export sealed ledger freshnessWindow: Uint<64>;
  /// The policy digest every accepted claim must carry, sealed at deploy.
  export sealed ledger policyDigest: Bytes<32>;
  /// Maximum observation window length (seconds), sealed at deploy.
  export sealed ledger maxWindow: Uint<32>;
  export ledger claimsVault: Map<Bytes<32>, ClaimEntry>;
  export ledger nullifiers: Set<Bytes<32>>;

  witness getAttestationWitness(): [Claim, Vector<M, Schnorr_SchnorrSignature>, Bytes<32>];
  witness getHolderSecret(): Bytes<32>;

  /// Pseudonymous holder identity: hashToCurve over a domain-separated holder
  /// secret. The resulting binding is the on-chain pseudonym for claim entries.
  circuit deriveHolder(secret: Bytes<32>): Field {
    return jubjubPointX(hashToCurve<Vector<2, Bytes<32>>>([pad(32, "thoth:holder:v1"), secret]));
  }

  /// Holder commitment signed into the claim: a domain-separated hash of the
  /// holder secret. Distinct from the vault pseudonym (`deriveHolder`).
  export pure circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "thoth:holder-commit:v1"), secret]);
  }

  /// Reconstruct the flat signed message. Wire layout, in order:
  ///   [0] version  [1] kind
  ///   [2] degradeToTransient(policyDigest)  [3] degradeToTransient(requestBinding)
  ///   [4] degradeToTransient(holder)        [5] degradeToTransient(nonce)
  ///   [6] windowStart  [7] windowEnd
  ///   [8 .. 8+V)    present flags (1/0)
  ///   [8+V .. 8+2V) values
  /// so at specialization the message has length 8 + 2*V, which must equal K
  /// (enforced by the embedder). This is the single wire shape the attestor
  /// must mirror (`@thoth/core/claim`'s `claimToMessage`).
  export pure circuit buildMessage(c: Claim): Vector<K, Field> {
    const header: Vector<8, Field> =
            [c.version as Field,
             c.kind as Field,
             degradeToTransient(c.policyDigest),
             degradeToTransient(c.requestBinding),
             degradeToTransient(c.holder),
             degradeToTransient(c.nonce),
             c.windowStart as Field,
             c.windowEnd as Field,];
    const presentFields: Vector<V, Field> = map((p: Boolean) => p as Field, c.present);
    const valuesFields: Vector<V, Field> = map((v: Uint<64>) => v as Field, c.values);
    return [...header, ...presentFields, ...valuesFields];
  }

  /// The Poseidon challenge hash over (announcement, public key, message).
  /// Delegates to the generic schnorr module's pure circuit so off-chain
  /// signing and the in-circuit verifier share a single implementation.
  /// Exported here for signing parity (the attestor signs
  /// c = cFull mod 2^248 via the same layout the in-circuit verifier computes).
  export pure circuit schnorrChallenge(
                        ann_x: Field,
                        ann_y: Field,
                        pk_x: Field,
                        pk_y: Field,
                        msg: Vector<K, Field>
                        ): Field {
    return Schnorr_schnorrChallenge<K>(ann_x, ann_y, pk_x, pk_y, msg);
  }

  /// Claim id = persistentCommit(claim, rand) — must match the id
  /// verifyAttestation stores under. Exported pure for test parity.
  export pure circuit computeId(claim: Claim, rand: Bytes<32>): Bytes<32> {
    return persistentCommit<Claim>(claim, rand);
  }

  /// Derive a holder off-chain identically to the in-circuit derivation.
  /// Exported pure for test parity.
  export pure circuit holderOf(secret: Bytes<32>): Field {
    return deriveHolder(secret);
  }

  /// Verify an attested claim against the policy, holder, window, signature
  /// and replay gates, then store it.
  export circuit verifyAttestation(): [] {
    const [claim, sigs, rand] = getAttestationWitness();
    const secret = getHolderSecret();
    assert(claim.version == 1, "Unsupported claim version");
    assert(claim.kind == 1, "Unsupported kind");
    assert(claim.policyDigest == policyDigest, "Wrong policy digest");
    assert(claim.holder == holderCommitment(secret), "Holder mismatch");
    assert(claim.windowStart <= claim.windowEnd, "Window inverted");
    assert(claim.windowEnd - claim.windowStart <= maxWindow, "Window too long");

    const msg = buildMessage(claim);
    assert(Registry_countValidSignatures(msg, sigs) >= (N as Uint<64>),
           "Insufficient valid signatures"
           );

    assert(blockTimeGte(disclose(claim.windowStart as Uint<64>)), "Window in the future");
    assert(blockTimeLt(disclose((claim.windowEnd + freshnessWindow) as Uint<64>)), "Window too old");

    const nullifier = persistentHash<Vector<2, Bytes<32>>>([pad(32, "thoth:nonce:"), claim.nonce]);
    assert(!nullifiers.member(disclose(nullifier)), "Nonce replay");
    nullifiers.insert(disclose(nullifier));

    const id = persistentCommit<Claim>(claim, rand);
    assert(!claimsVault.member(id), "Claim already accepted");
    claimsVault.insert(
      id,
      ClaimEntry { holder: disclose(deriveHolder(secret)), timestamp: disclose(claim.windowEnd) }
      );
  }

  /// Prove the caller owns a vaulted claim and re-hydrate it in-circuit
  /// iReturns the claim so app predicates can read `values` directly.
  /// Consumes no nullifier, so opening is repeatable (apps that need
  /// "use once" enforce it with their own holder-keyed state — see README).
  /// Never re-export this as a top-level contract entry point: its return
  /// value is tainted and would force a disclose that reveals every value.
  export circuit openClaim(id: Bytes<32>): Claim {
    const [claim,, commitRand] = getAttestationWitness();
    const key = disclose(id);
    assert(claimsVault.member(key), "Unknown claim");
    assert(claimsVault.lookup(key).holder == disclose(deriveHolder(getHolderSecret())),
           "Claim not bound to caller"
           );
    assert(persistentCommit<Claim>(claim, commitRand) == key, "Claim does not match id");
    return claim;
  }
}
