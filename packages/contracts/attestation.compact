// Thoth attestation module: verifies an N-of-M attested `Claim`, rejects
// claims for another app, replays and out-of-window claims, and vaults it under
// its nullifier. The registry checks the #N signatures, each against the
// registry slot it names; this module defines the signed message.
//
// Wire layout (buildMessage): attestors sign these seven field elements, the
// `SignedMessage` struct as `transientHash` flattens it:
//   [ version, V, W,
//     nullifier[31], nullifier[0..31],
//     holder[31], holder[0..31] ]
// A 32-byte value is two elements, byte 31, then bytes 0-30 read
// little-endian (byte 0 least significant, the runtime's `convertBytesToUint`
// convention). Byte ranges are half-open (holder[0..31] is bytes 0-30).
// The nullifier is the SHA-256 (`persistentHash<Observation>`) of the
// observation identity, 136 + 9*V + 33*W bytes in this order:
//   appId (32), policyHash (32), subjectHash (32), salt (32),
//   windowStart (4), windowEnd (4),
//   values[0], ..., values[V-1] (8 each),
//   byteValues[0], ..., byteValues[W-1] (32 each),
//   present[0], ..., present[V-1] (1 each),
//   bytePresent[0], ..., bytePresent[W-1] (1 each)
// Integers are little-endian at their width; a Boolean byte is 0 or 1.
// `version` and `holder` reach the message directly, every other claim field
// through the nullifier. `nullifierOf` and `claimToMessage` in
// `@thoth/core/claim` mirror this.
// The message carries V and W because the identity's length fixes only
// 9*V + 33*W: two layouts (V=11, W=0 and V=0, W=3) can serialize to the same
// bytes, and a message signed under one must fail verification under the
// other. The sealed appId does not separate them: every contract of one app
// seals the same one.
//
// Module parameters (import "attestation"<V, W, N, M>), fixed when a contract
// embeds the module:
//   #V — number of numeric value slots (Claim.values: Vector<V, Uint<64>>).
//   #W — number of byte value slots (Claim.byteValues: Vector<W, Bytes<32>>).
//        W = 0 is the numeric-only layout.
//   #N — the threshold: `getSignatures` supplies #N signatures from distinct
//        registry slots, and all of them must verify.
//   #M — number of registry slots, the registry's key count.
// A contract that imports the registry itself, to call `initRegistry`,
// imports it as "attestor_registry"<M, SignedMessage>, with this module's
// prefix on `SignedMessage`. Other parameters compile to a second registry
// whose keys this module never reads, so no claim would verify.
pragma language_version >= 0.22;

module attestation<#V, #W, #N, #M> {
  import CompactStandardLibrary;

  /// The signed message; the file header gives its wire layout. Declared
  /// before the registry import, which takes it as its message type.
  export struct SignedMessage {
    version: Uint<8>;
    v: Field; // this contract's #V
    w: Field; // this contract's #W
    nullifier: Bytes<32>;
    holder: Bytes<32>;
  }

  import "attestor_registry"<M, SignedMessage> prefix Registry_;

  export struct ClaimEntry {
    holder: Field;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
  }

  export struct Claim {
    version: Uint<8>; // wire version (1)
    appId: Bytes<32>; // the app the claim is for
    policyHash: Bytes<32>; // hash of the policy the attestors enforced
    windowStart: Uint<32>; // Unix seconds the attestor's observation began (ADR 0005)
    windowEnd: Uint<32>; // Unix seconds the attestor's observation ended
    subjectHash: Bytes<32>; // circuit hash of what the claim is about (ADR 0001)
    holder: Bytes<32>; // per-claim commitment of the caller secret (ADR 0004)
    salt: Bytes<32>; // secret the attestors derive from the evidence; keys the nullifier (ADR 0012)
    present: Vector<V, Boolean>; // present[i] = values[i] was measured, even if 0
    bytePresent: Vector<W, Boolean>; // bytePresent[i] = byteValues[i] was measured, even if all zero
    values: Vector<V, Uint<64>>; // positional numeric values; 0 is a valid measured value
    byteValues: Vector<W, Bytes<32>>; // positional 32-byte values, zero-padded (ADR 0009)
  }

  /// The observation identity (ADR 0006): what the nullifier hashes and what
  /// `openClaim` returns. Holder and version are not hashed directly; the
  /// holder reaches it only through the kind's salt. The secret salt keeps the
  /// public nullifier from confirming guessed values (ADR 0012). The field
  /// order is the wire layout's: the attestors sign the nullifier, so
  /// reordering, adding or retyping a field changes what they sign.
  export struct Observation {
    appId: Bytes<32>;
    policyHash: Bytes<32>;
    subjectHash: Bytes<32>;
    salt: Bytes<32>;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
    values: Vector<V, Uint<64>>;
    byteValues: Vector<W, Bytes<32>>;
    present: Vector<V, Boolean>;
    bytePresent: Vector<W, Boolean>;
  }

  /// The app this contract accepts claims for, sealed by the top-level
  /// constructor (ADR 0013).
  export sealed ledger appId: Bytes<32>;
  /// Seconds after `windowEnd` a claim stays submittable, sealed by the
  /// top-level constructor. 0 does not disable the check: the claim must then
  /// land inside its window.
  export sealed ledger freshnessWindow: Uint<64>;
  /// Longest accepted observation window in seconds, sealed by the top-level
  /// constructor.
  export sealed ledger maxWindow: Uint<64>;
  /// Accepted policy hashes, sealed by the top-level constructor (ADR 0008).
  export sealed ledger policyHashes: Set<Bytes<32>>;
  /// Accepted claims, keyed by their nullifier (ADR 0016). A key present here
  /// is an observation already accepted.
  export ledger claimsVault: Map<Bytes<32>, ClaimEntry>;

  witness getAttestationWitness(): Claim;
  // A witness of its own, so `openClaim` does not pay for signature inputs it
  // never reads (about 60 rows per signature).
  witness getSignatures(): Vector<N, Registry_SlotSignature>;
  witness getHolderSecret(): Bytes<32>;
  // `openClaim` proves ownership with the pseudonym's scalar itself: knowing it
  // is what owning the pseudonym means, it skips a 370-row conversion, and a
  // circuit whose only Jubjub values come from converting a Field gets a
  // proving key that proof server 9.0.0 cannot read.
  witness getHolderScalar(): JubjubScalar;

  // 22 tag bytes keep the preimage at 54 bytes, one SHA-256 block: 55 bytes
  // is the most one block holds after padding.
  struct HolderCommitmentPreimage {
    tag: Bytes<22>;
    secret: Bytes<32>;
  }

  /// The vault pseudonym of a holder secret: the x coordinate of `s * G` on
  /// Jubjub, where `s` is the secret's first 31 bytes read little-endian
  /// (`degradeToTransient`). It stays stable across network upgrades because
  /// it depends only on the embedded curve, like the registry's keys, while
  /// `hashToCurve` and `transientHash` may change on a hard fork (ADR 0017).
  circuit deriveHolder(secret: Bytes<32>): Field {
    return pseudonymOf(degradeToTransient(secret) as JubjubScalar);
  }

  /// The vault pseudonym of the holder scalar `s`: the x coordinate of `s * G`.
  /// Only `s` itself gives the pseudonym: `s * G` lies in the prime-order
  /// subgroup, where no other point shares its x coordinate.
  circuit pseudonymOf(s: JubjubScalar): Field {
    return jubjubPointX(ecMulGenerator(s));
  }

  circuit messageOf(version: Uint<8>, nullifier: Bytes<32>, holder: Bytes<32>): SignedMessage {
    return SignedMessage { version: version,
                           v: V as Field,
                           w: W as Field,
                           nullifier: nullifier,
                           holder: holder };
  }

  /// The signed message, per the wire layout in the file header: the claim's
  /// version, this contract's layout, the claim's nullifier and its holder
  /// (ADR 0014). The nullifier carries every other field, so
  /// `verifyAttestation` hashes the claim once for the signatures and replay.
  export pure circuit buildMessage(c: Claim): SignedMessage {
    return messageOf(c.version, nullifierOf(c), c.holder);
  }

  /// The vault pseudonym of a holder secret. Exported pure so tests can
  /// reproduce it.
  export pure circuit holderOf(secret: Bytes<32>): Field {
    return deriveHolder(secret);
  }

  /// The per-claim holder commitment (ADR 0004): SHA-256 of the 22-byte tag
  /// `thoth:holder-commit:v1` followed by the secret. It is a different
  /// function from `deriveHolder`, so the commitment the attestors sign cannot
  /// be linked to the vault pseudonym on the ledger. Exported pure so
  /// `holderCommitmentOf` in `@thoth/core/claim-context` can match it.
  export pure circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentHash<HolderCommitmentPreimage>(
             HolderCommitmentPreimage { tag: pad(22, "thoth:holder-commit:v1"), secret: secret }
             );
  }

  /// The observation identity of a claim: every field but `holder` and
  /// `version`.
  circuit observationOf(claim: Claim): Observation {
    return Observation { appId: claim.appId,
                         policyHash: claim.policyHash,
                         subjectHash: claim.subjectHash,
                         salt: claim.salt,
                         windowStart: claim.windowStart,
                         windowEnd: claim.windowEnd,
                         values: claim.values,
                         byteValues: claim.byteValues,
                         present: claim.present,
                         bytePresent: claim.bytePresent };
  }

  /// The nullifier of a claim: the SHA-256 of its observation identity (wire
  /// layout in the file header). The attestors sign it, and
  /// `verifyAttestation` vaults the claim under it. It is a persistent hash, so
  /// a vaulted claim stays openable, and replay protection holds, across
  /// network upgrades. Exported pure so a dApp can compute the key it opens
  /// the claim with.
  export pure circuit nullifierOf(claim: Claim): Bytes<32> {
    return persistentHash<Observation>(observationOf(claim));
  }

  /// Verify an attested claim and store it in the claims vault.
  export circuit verifyAttestation(): [] {
    const claim = getAttestationWitness();
    assert(claim.version == 1, "Unsupported claim version");
    assert(claim.appId == appId, "App id mismatch");
    assert(policyHashes.member(disclose(claim.policyHash)), "Unaccepted policy");

    // One hash of the claim serves the signatures, replay and the vault key
    // (ADR 0014, ADR 0016).
    const nullifier = disclose(nullifierOf(claim));
    const message = messageOf(claim.version, nullifier, claim.holder);
    Registry_requireSignatures<N>(message, getSignatures());

    const validSlots =
            map((present: Boolean, value: Uint<64>) => present || value == 0,
                claim.present,
                claim.values);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validSlots),
           "Absent slot has nonzero value"
           );

    const zeroBytes = pad(32, "");
    const validBytes =
            map((present: Boolean, value: Bytes<32>) => present || value == zeroBytes,
                claim.bytePresent,
                claim.byteValues);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validBytes),
           "Absent slot has nonzero value"
           );

    assert(claim.windowStart <= claim.windowEnd, "Window inverted");
    assert(claim.windowEnd - claim.windowStart <= maxWindow, "Window too long");
    assert(blockTimeGte(disclose(claim.windowStart as Uint<64>)), "Window in the future");
    assert(blockTimeLt(disclose((claim.windowEnd + freshnessWindow) as Uint<64>)), "Window too old");

    const secret = getHolderSecret();
    assert(claim.holder == holderCommitment(secret), "Holder mismatch");

    // The vault key is the public nullifier: a separate commitment published
    // beside it would hide nothing more and cost a second hash of the claim
    // (ADR 0016).
    assert(!claimsVault.member(nullifier), "Observation replay");
    claimsVault.insert(
      nullifier,
      ClaimEntry { holder: disclose(deriveHolder(secret)),
                   windowStart: disclose(claim.windowStart),
                   windowEnd: disclose(claim.windowEnd) }
      );
  }

  /// Prove the caller owns the claim vaulted under `nullifier` and return
  /// its observation identity for in-circuit predicates. The nullifier binds
  /// every returned field; `holder` and `version` are not returned because it
  /// does not hash them. A byte value is a whole `Bytes<32>`: compare it
  /// directly (`c.byteValues[i] == expected`).
  /// Consumes nothing, so opening is repeatable: "use once" is the app's own
  /// state. Never re-export it as a top-level entry point: its return value
  /// is tainted and would force a disclose that reveals every value.
  export circuit openClaim(nullifier: Bytes<32>): Observation {
    const claim = getAttestationWitness();
    const key = disclose(nullifier);
    assert(claimsVault.member(key), "Unknown claim");
    assert(claimsVault.lookup(key).holder == disclose(pseudonymOf(getHolderScalar())),
           "Claim not bound to caller"
           );
    const observation = observationOf(claim);
    assert(persistentHash<Observation>(observation) == key, "Claim does not match nullifier");
    return observation;
  }
}
