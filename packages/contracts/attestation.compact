// Thoth Attestation module.
//
// Verifies an off-chain attested `Claim` against an N-of-M attestor
// signature threshold, controls replay and the observation window, and stores
// a claimsVault entry keyed by `persistentCommit(claim, rand)`.
//
// Responsibilities:
//   - verify >= #N of #M signatures from the appended AttestorRegistry over the
//     frozen flat message built by `buildMessage` (this module's contract law);
//   - reject a claim whose `policyHash` is not in the sealed `policyHashes`
//     set. The policy hash is the on-chain binding: there is no kind code, and
//     a contract serves several policies (kinds) by sealing several hashes;
//   - sign `subjectHash` into the message but not check it: an app that binds
//     the source recomputes it in-circuit from private subject fields and
//     compares it to `claim.subjectHash` (ADR 0001);
//   - require the caller secret to match the signed per-claim holder commitment;
//   - require every absent value slot to carry zero — numeric slots and byte
//     halves alike;
//   - reject observation replay via the nullifiers set;
//   - check the observation window (ADR 0005), unconditionally: it must not be
//     inverted nor longer than the sealed `maxWindow`, the block time must be
//     at or after `windowStart`, and before `windowEnd + freshnessWindow`.
//     A zero `freshnessWindow` does not disable the check: the block time must
//     then fall inside the window itself;
//   - store { holder, windowStart, windowEnd } in the claimsVault. Nothing is
//     returned: the app composes its own predicates over the claim via
//     `openClaim`.
//
// Signature counting is delegated to the registry; the threshold decision
// (#N) lives here. The message shape (order+sizes) is the single thing the
// attestor must mirror, per the documented wire layout below.
//
// Byte value slots: a byte value is 32 bytes carried as two adjacent
// 16-byte halves (`byteHalves: Vector<B, Bytes<16>>`, B = 2W) with one presence
// flag per half (`bytePresent`). Both halves of one value carry the same flag in
// honest claims: the attestor law derives them from a single disclosure.
//
// Wire layout (buildMessage), K = 11 + 2*V + 2*B fields:
//   [ version,
//     appId[0..16] as Uint<128>, appId[16..32] as Uint<128>,
//     policyHash[0..16] as Uint<128>, policyHash[16..32] as Uint<128>,
//     windowStart, windowEnd,
//     subjectHash[0..16] as Uint<128>, subjectHash[16..32] as Uint<128>,
//     holder[0..16] as Uint<128>, holder[16..32] as Uint<128>,
//     present[0] as Field, ..., present[V-1] as Field,
//     bytePresent[0] as Field, ..., bytePresent[B-1] as Field,
//     values[0] as Field, ..., values[V-1] as Field,
//     byteHalves[0] as Field, ..., byteHalves[B-1] as Field ]
// Byte ranges are half-open (appId[0..16] is bytes 0-15). Each 32-byte field
// is split in two halves so every byte is signed; each 16-byte half is read
// little-endian (byte 0 least significant) when cast to Uint<128>/Field, the
// runtime's `convertBytesToUint` convention. `claimToMessage` uses the same
// primitive, so the two encoders agree field-for-field.
//
// Module parameters (import "attestation"<K, V, B, N, M>):
//   #K — signed-message length in fields. Must equal 11 + 2*V + 2*B (the
//        11-field header in buildMessage, the V numeric presence fields, the B
//        byte-half presence fields, the V value fields, and the B half fields).
//        This is what the registry's countValidSignatures verifies over.
//   #V — number of numeric claim value slots (Claim.values: Vector<V, Uint<64>>).
//   #B — number of byte halves (Claim.byteHalves: Vector<B, Bytes<16>>): twice
//        the number of 32-byte byte value slots. B = 0 is valid and reproduces
//        the numeric-only layout exactly.
//   #N — the app's N-of-M threshold: at least #N of the #M signatures must
//        verify for a claim to be accepted.
//   #M — number of attestor signatures supplied / registry key slots.
// All parameters are fixed when a contract embeds the module.
pragma language_version >= 0.22;

module attestation<#K, #V, #B, #N, #M> {
  import CompactStandardLibrary;
  import "attestor_registry"<M, K> prefix Registry_;

  export struct ClaimEntry {
    holder: Field;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
  }

  export struct Claim {
    version: Uint<8>; // schema version (1)
    appId: Bytes<32>; // the app the claim is for
    policyHash: Bytes<32>; // hash of the policy the attestors enforced
    windowStart: Uint<32>; // Unix seconds the attestor's observation began (ADR 0005)
    windowEnd: Uint<32>; // Unix seconds the attestor's observation ended
    subjectHash: Bytes<32>; // circuit hash of what the claim is about (ADR 0001)
    holder: Bytes<32>; // per-claim commitment of the caller secret (ADR 0004)
    present: Vector<V, Boolean>; // present[i] = values[i] was populated (measured), even if 0
    bytePresent: Vector<B, Boolean>; // bytePresent[j] = byteHalves[j] was measured; one flag per half
    values: Vector<V, Uint<64>>; // positional numeric claim values; 0 IS a valid value
    byteHalves: Vector<B, Bytes<16>>; // interleaved halves: [b0[0..16], b0[16..32], b1[0..16], ...]
  }

  // Observation identity (ADR 0006). Holder and version do not distinguish facts.
  struct Observation {
    appId: Bytes<32>;
    policyHash: Bytes<32>;
    subjectHash: Bytes<32>;
    windowStart: Uint<32>;
    windowEnd: Uint<32>;
    values: Vector<V, Uint<64>>;
    byteHalves: Vector<B, Bytes<16>>;
    present: Vector<V, Boolean>;
    bytePresent: Vector<B, Boolean>;
  }

  /// Freshness window (seconds), sealed at deploy by the top-level
  /// constructor: how long after `windowEnd` a claim stays submittable.
  /// 0 does not disable the check; the claim must then land inside its window.
  export sealed ledger freshnessWindow: Uint<64>;
  /// Longest accepted observation window (seconds), sealed at deploy by the
  /// top-level constructor.
  export sealed ledger maxWindow: Uint<64>;
  /// Accepted policy hashes, sealed at deploy by the top-level constructor.
  /// A claim is accepted only under one of these policies.
  export sealed ledger policyHashes: Set<Bytes<32>>;
  export ledger claimsVault: Map<Bytes<32>, ClaimEntry>;
  export ledger nullifiers: Set<Bytes<32>>;

  witness getAttestationWitness(): [Claim, Vector<M, JubjubSchnorrSignature>, Bytes<32>];
  witness getHolderSecret(): Bytes<32>;

  /// Pseudonymous holder identity: hashToCurve over a domain-separated holder
  /// secret. The resulting binding is the on-chain pseudonym for claim entries.
  circuit deriveHolder(secret: Bytes<32>): Field {
    return jubjubPointX(hashToCurve<Vector<2, Bytes<32>>>([pad(32, "thoth:holder:v1"), secret]));
  }

  /// Split 32 bytes into two 16-byte halves, each cast to a Field, so every
  /// byte reaches the signed message (a single Field holds only 31 bytes).
  circuit splitBytes(b: Bytes<32>): Vector<2, Field> {
    return [(slice<16>(b, 0) as Uint<128>) as Field, (slice<16>(b, 16) as Uint<128>) as Field];
  }

  /// Cast one 16-byte half to a Field for the signed message.
  circuit halfAsField(h: Bytes<16>): Field {
    return (h as Uint<128>) as Field;
  }

  /// Reconstruct the flat signed message: an 11-field fixed header (version,
  /// appId and policyHash each as two 16-byte halves, windowStart, windowEnd,
  /// then subjectHash as two 16-byte halves, then the holder commitment
  /// as two halves) followed by the `present` flags, the per-half
  /// `bytePresent` flags, the values mapped to `Field`, and the byte halves.
  /// Tuple/vector spread (`...`) appends each section, so at specialization
  /// `[header..., present..., bytePresent..., values..., byteHalves...]` has
  /// length 11 + 2*V + 2*B, which must equal K (enforced by the embedder).
  /// This is the single wire shape the attestor must mirror.
  export pure circuit buildMessage(c: Claim): Vector<K, Field> {
    const appId = splitBytes(c.appId);
    const policyHash = splitBytes(c.policyHash);
    const subjectHash = splitBytes(c.subjectHash);
    const holder = splitBytes(c.holder);
    const header: Vector<11, Field> =
            [c.version as Field,
             appId[0],
             appId[1],
             policyHash[0],
             policyHash[1],
             c.windowStart as Field,
             c.windowEnd as Field,
             subjectHash[0],
             subjectHash[1],
             holder[0],
             holder[1],];
    const presentFields: Vector<V, Field> = map((p: Boolean) => p as Field, c.present);
    const bytePresentFields: Vector<B, Field> = map((p: Boolean) => p as Field, c.bytePresent);
    const valuesFields: Vector<V, Field> = map((v: Uint<64>) => v as Field, c.values);
    const byteFields: Vector<B, Field> = map(halfAsField, c.byteHalves);
    return [...header, ...presentFields, ...bytePresentFields, ...valuesFields, ...byteFields];
  }

  /// Claim id = persistentCommit(claim, rand) — must match the id
  /// verifyAttestation stores under. Exported pure for test parity.
  export pure circuit computeId(claim: Claim, rand: Bytes<32>): Bytes<32> {
    return persistentCommit<Claim>(claim, rand);
  }

  /// Derive a holder off-chain identically to the in-circuit derivation.
  /// Exported pure for test parity.
  export pure circuit holderOf(secret: Bytes<32>): Field {
    return deriveHolder(secret);
  }

  /// Per-claim holder commitment (ADR 0004): persistentHash over a
  /// domain-separated holder secret. Tagged apart from `deriveHolder`'s vault
  /// pseudonym, so one secret yields unrelated values in the two roles.
  /// Exported pure so the off-chain `holderCommitmentOf` can match it.
  export pure circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "thoth:holder-commitment:v1"), secret]);
  }

  /// Verify an attested claim, on replay + observation-window gates, then
  /// store it.
  export circuit verifyAttestation(): [] {
    const [claim, sigs, rand] = getAttestationWitness();
    assert(claim.version == 1, "Unsupported claim version");
    assert(policyHashes.member(disclose(claim.policyHash)), "Unaccepted policy");

    const msg = buildMessage(claim);
    assert(Registry_countValidSignatures(msg, sigs) >= (N as Uint<64>),
           "Insufficient valid signatures"
           );

    const validSlots =
            map((present: Boolean, value: Uint<64>) => present || value == 0,
                claim.present,
                claim.values);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validSlots),
           "Absent slot has nonzero value"
           );

    const zeroHalf = pad(16, "");
    const validHalves =
            map((present: Boolean, half: Bytes<16>) => present || half == zeroHalf,
                claim.bytePresent,
                claim.byteHalves);
    assert(fold((valid: Boolean, slot: Boolean) => valid && slot, true, validHalves),
           "Absent slot has nonzero value"
           );

    assert(claim.windowStart <= claim.windowEnd, "Window inverted");
    assert(claim.windowEnd - claim.windowStart <= maxWindow, "Window too long");
    assert(blockTimeGte(disclose(claim.windowStart as Uint<64>)), "Window in the future");
    assert(blockTimeLt(disclose((claim.windowEnd + freshnessWindow) as Uint<64>)), "Window too old");

    const secret = getHolderSecret();
    assert(claim.holder == holderCommitment(secret), "Holder mismatch");

    const nullifier =
            persistentHash<Observation>(
              Observation { appId: claim.appId,
                            policyHash: claim.policyHash,
                            subjectHash: claim.subjectHash,
                            windowStart: claim.windowStart,
                            windowEnd: claim.windowEnd,
                            values: claim.values,
                            byteHalves: claim.byteHalves,
                            present: claim.present,
                            bytePresent: claim.bytePresent }
              );
    assert(!nullifiers.member(disclose(nullifier)), "Observation replay");
    nullifiers.insert(disclose(nullifier));

    const id = persistentCommit<Claim>(claim, rand);
    assert(!claimsVault.member(id), "Claim already accepted");
    claimsVault.insert(
      id,
      ClaimEntry { holder: disclose(deriveHolder(secret)),
                   windowStart: disclose(claim.windowStart),
                   windowEnd: disclose(claim.windowEnd) }
      );
  }

  /// Prove the caller owns a vaulted claim and re-hydrate it in-circuit
  /// Returns the claim so app predicates can read `values` and `byteHalves`
  /// directly (reassemble a byte value with
  /// `Bytes[...c.byteHalves[2 * i], ...c.byteHalves[2 * i + 1]]`).
  /// Consumes no nullifier, so opening is repeatable (apps that need
  /// "use once" enforce it with their own holder-keyed state — see README).
  /// Never re-export this as a top-level contract entry point: its return
  /// value is tainted and would force a disclose that reveals every value.
  export circuit openClaim(id: Bytes<32>): Claim {
    const [claim,, commitRand] = getAttestationWitness();
    const key = disclose(id);
    assert(claimsVault.member(key), "Unknown claim");
    assert(claimsVault.lookup(key).holder == disclose(deriveHolder(getHolderSecret())),
           "Claim not bound to caller"
           );
    assert(persistentCommit<Claim>(claim, commitRand) == key, "Claim does not match id");
    return claim;
  }
}
