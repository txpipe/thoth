// Thoth attestor registry module: the app's M pinned attestor public keys and
// `requireSignatures`, which checks N signatures over one message, each
// against the key of the registry slot it names. The attestation module that
// embeds it defines the message and the threshold N.
//
// The keys are a sealed, unexported ledger that only `initRegistry` writes,
// once, at deploy. Do not re-export `initRegistry`: a sealed field cannot be
// written from an exported circuit, so that is a compile error.
//
// Module parameters (import "attestor_registry"<M, Msg>):
//   #M  — number of registry slots, the number of pinned keys. A slot is a
//         `Uint<8>`, so only the first 256 slots can be named: keep M at 256
//         or below.
//   Msg — the signed message's type. The Schnorr challenge absorbs a message
//         as `transientHash` flattens it, so a signature over that flattening
//         as a `Vector<K, Field>` verifies, and a struct message needs no
//         slicing. It must not hold a `JubjubPoint` (see `verifySignature`).
pragma language_version >= 0.22;

module attestor_registry<#M, Msg> {
  import CompactStandardLibrary;

  /// The M pinned attestor public keys.
  sealed ledger keys: Vector<M, JubjubPoint>;

  /// Whether `initRegistry` has run.
  ledger initialized: Boolean;

  /// Deploy-time witness providing the M attestor public keys.
  witness seedKeys(): Vector<M, JubjubPoint>;

  /// Pin the keys from the `seedKeys` witness. Rejects a second call and
  /// duplicate keys (empty slots exempt), so the threshold counts distinct keys.
  export circuit initRegistry(): [] {
    assert(!initialized, "Registry already initialized");
    initialized = true;
    const ks: Vector<M, JubjubPoint> = seedKeys();
    keys = disclose(ks);
    assert(keysDistinct(ks), "Duplicate registry keys");
  }

  /// A Jubjub Schnorr signature: the values of the stdlib
  /// `JubjubSchnorrSignature`, with the response typed as a Jubjub scalar.
  /// A scalar witness costs about 60 rows; converting a Field response, as the
  /// stdlib verifier does, costs about 390.
  export struct Signature {
    announcement: JubjubPoint;
    response: JubjubScalar;
  }

  /// One signature and the registry slot whose key it is checked against.
  export struct SlotSignature {
    registryIndex: Uint<8>;
    signature: Signature;
  }

  /// The stdlib `jubjubSchnorrVerify` check, `s·G == R + c·pk` with
  /// `c = transientHash(R.x, R.y, pk.x, pk.y, msg...)`, so the runtime's
  /// `jubjubSchnorrSign` signatures verify unchanged. Unlike the stdlib it does
  /// not reject the empty key itself; `requireSignatures` does.
  circuit verifySignature(msg: Msg, sig: Signature, pk: JubjubPoint): Boolean {
    // The coordinates are spelled out: a `transientHash` over a type holding a
    // `JubjubPoint` compiles to IR that fails circuit synthesis.
    const challenge =
            transientHash<[Field, Field, Field, Field, Msg]>(
              [jubjubPointX(sig.announcement),
               jubjubPointY(sig.announcement),
               jubjubPointX(pk),
               jubjubPointY(pk),
               msg]
              );
    const c = challenge as JubjubScalar;
    return ecMulGenerator(sig.response) == ecAdd(sig.announcement, ecMul(pk, c));
  }

  /// The key in slot `slot` of `ks`, or `none` when `slot >= M`. A vector
  /// subscript must be a constant, so this selects across every slot.
  circuit keyAt(ks: Vector<M, JubjubPoint>, slot: Uint<8>, none: JubjubPoint): JubjubPoint {
    const found = fold((acc: [Field, JubjubPoint], k: JubjubPoint) =>
                       [acc[0] + 1, acc[0] == (slot as Field) ? k : acc[1]],
                       [0 as Field, none],
                       ks);
    return found[1];
  }

  /// Require each of the N signatures to verify against the key in the slot
  /// it names: `sigs[j].signature` against `keys[sigs[j].registryIndex]`.
  /// Slots must be strictly increasing, so no slot counts twice, and must hold
  /// a key: the empty key would accept a forged signature.
  export circuit requireSignatures<#N>(msg: Msg, sigs: Vector<N, SlotSignature>): [] {
    const ks = keys;
    const none = default<JubjubPoint>;
    const order = fold((acc: [Boolean, Uint<16>], s: SlotSignature) =>
                       [acc[0] && (s.registryIndex as Uint<16>) >= acc[1],
                        (s.registryIndex + 1) as Uint<16>],
                       [true, 0 as Uint<16>],
                       sigs);
    assert(order[0], "Registry slots not increasing");
    for (const s of sigs) {
      const key = keyAt(ks, s.registryIndex, none);
      assert(key != none, "Empty registry slot");
      assert(verifySignature(msg, s.signature, key), "Insufficient valid signatures");
    }
  }

  /// How many slots of `ks` hold `k`. Empty slots count like any other, so a
  /// truly empty key (the `default<JubjubPoint>` value) occurs once per
  /// unfilled slot.
  circuit keyCount(ks: Vector<M, JubjubPoint>, k: JubjubPoint): Uint<64> {
    return fold((acc: Uint<64>, k2: JubjubPoint) => (acc + (k == k2 ? 1 : 0)) as Uint<64>,
                0 as Uint<64>,
                ks);
  }

  /// Whether every non-empty key occupies exactly one slot. Checked once at
  /// deploy, so it costs nothing per claim.
  export circuit keysDistinct(ks: Vector<M, JubjubPoint>): Boolean {
    return fold((distinct: Boolean, k: JubjubPoint) =>
                distinct && (k == default<JubjubPoint> || keyCount(ks, k) == 1),
                true,
                ks);
  }
}
