// Test mock: the modules specialized to V=3, B=0, K=20, 2-of-3, with the pure
// circuits, types and ledgers the simulator tests read.
pragma language_version >= 0.22;

import CompactStandardLibrary;

//           K=20 msg fields  V=3 values  B=0 byte halves  N=2 threshold  M=3 signatures
import "../../attestation"<20, 3, 0, 2, 3> prefix A_;

import "../../attestor_registry"<3, 20> prefix R_;

export { A_Claim, A_ClaimEntry };

export { A_appId, A_freshnessWindow, A_maxWindow, A_policyHashes, A_claimsVault, A_nullifiers };

// A four-field subject, so a test can check `persistentHash<Subject>` against
// the off-chain subject hash in `@txpipe/thoth-core/claim-context`.
export struct Subject {
  method: Bytes<32>;
  host: Bytes<32>;
  path: Bytes<32>;
  body: Bytes<32>;
}

export pure circuit subjectHash(s: Subject): Bytes<32> {
  return persistentHash<Subject>(s);
}

export circuit verifyAttestation(): [] {
  A_verifyAttestation();
}

export pure circuit message(a: A_Claim): Vector<20, Field> {
  return A_buildMessage(a);
}

export pure circuit computeId(a: A_Claim, rand: Bytes<32>): Bytes<32> {
  return A_computeId(a, rand);
}

export pure circuit nullifierOf(a: A_Claim): Bytes<32> {
  return A_nullifierOf(a);
}

export pure circuit holderOf(secret: Bytes<32>): Field {
  return A_holderOf(secret);
}

export pure circuit holderCommitment(secret: Bytes<32>): Bytes<32> {
  return A_holderCommitment(secret);
}

export pure circuit keysDistinct(ks: Vector<3, JubjubPoint>): Boolean {
  return R_keysDistinct(ks);
}

// App-predicate demo: open a vaulted claim and read two value slots.
// `openClaim` is not re-exported: its tainted return would force a disclose.
export circuit openAndRead(id: Bytes<32>, e0: Uint<64>, e1: Uint<64>): [] {
  const c = A_openClaim(id);
  assert(c.values[0] == e0, "value[0] mismatch");
  assert(c.values[1] == e1, "value[1] mismatch");
}

// App-predicate demo: read per-slot presence off a vaulted claim.
export circuit openAndReadPresence(id: Bytes<32>, p0: Boolean, p1: Boolean): [] {
  const c = A_openClaim(id);
  assert(c.present[0] == p0, "present[0] mismatch");
  assert(c.present[1] == p1, "present[1] mismatch");
}

// App-predicate demo: require slot 0 to be present before reading it. The
// index is fixed because Compact requires constant vector subscripts.
export circuit openAndRequireMetric0(id: Bytes<32>, expected: Uint<64>): [] {
  const c = A_openClaim(id);
  assert(c.present[0], "metric 0 not present");
  assert(c.values[0] == expected, "value[0] mismatch");
}

// App-predicate demo: source binding (ADR 0001). The subject is private
// input; the circuit recomputes its hash and pins only the host.
export circuit openAndBindHost(id: Bytes<32>, s: Subject, host: Bytes<32>): [] {
  const c = A_openClaim(id);
  assert(persistentHash<Subject>(s) == c.subjectHash, "Subject mismatch");
  assert(s.host == host, "Host not accepted");
}

witness seedAppId(): Bytes<32>;

witness freshWindow(): Uint<64>;

witness maxWin(): Uint<64>;

witness seedPolicies(): Vector<2, Bytes<32>>;

constructor() {
  A_appId = disclose(seedAppId());
  A_freshnessWindow = disclose(freshWindow());
  A_maxWindow = disclose(maxWin());
  for (const h of seedPolicies()) {
    A_policyHashes.insert(disclose(h));
  }
  R_initRegistry();
}
