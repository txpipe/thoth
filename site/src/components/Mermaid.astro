---
// Client-side Mermaid renderer; included by DocPage only on pages with a mermaid block.
---

<script>
  import { watchOverflow } from '../lib/overflow';

  function describeDiagram(source: string): string {
    const accTitle = source.match(/^\s*accTitle\s*:\s*(.+)$/m)?.[1]?.trim();
    if (accTitle) return accTitle;

    const firstLine = source
      .split('\n')
      .map((line) => line.trim())
      .find((line) => line.length > 0 && !line.startsWith('%%'));

    if (firstLine?.startsWith('sequenceDiagram')) {
      const participants = Array.from(
        source.matchAll(/^\s*(?:participant|actor)\s+(\S+)(?:\s+as\s+(.+))?$/gm),
        (match) => (match[2] ?? match[1] ?? '').trim(),
      ).filter(Boolean);
      return participants.length > 0
        ? `Sequence diagram: ${participants.join(', ')}`
        : 'Sequence diagram';
    }
    if (firstLine?.startsWith('flowchart') || firstLine?.startsWith('graph')) {
      return 'Flowchart diagram';
    }
    return 'Diagram';
  }

  const blocks = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
  if (blocks.length > 0) {
    const { default: mermaid } = await import('mermaid');
    const root = getComputedStyle(document.documentElement);
    const token = (name: string) => root.getPropertyValue(name).trim();
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      look: 'classic',
      // Draw the diagram from the site's tokens rather than Mermaid's palette.
      themeVariables: {
        fontFamily: token('--font-sans'),
        fontSize: '15px',
        background: 'transparent',
        primaryColor: token('--bg-card'),
        primaryTextColor: token('--fg-1'),
        primaryBorderColor: token('--stroke-2'),
        secondaryColor: token('--bg-card'),
        tertiaryColor: token('--bg-card'),
        mainBkg: token('--bg-card'),
        nodeBorder: token('--stroke-2'),
        lineColor: token('--stroke-1'),
        textColor: token('--fg-2'),
        edgeLabelBackground: token('--bg-card'),
        actorBkg: token('--bg-card'),
        actorBorder: token('--stroke-2'),
        actorTextColor: token('--fg-1'),
        actorLineColor: token('--stroke-2'),
        signalColor: token('--cyan-100'),
        signalTextColor: token('--fg-2'),
        labelBoxBkgColor: token('--bg-card'),
        labelBoxBorderColor: 'rgba(255, 23, 159, 0.40)',
        labelTextColor: token('--fg-2'),
        loopTextColor: token('--fg-2'),
        noteBkgColor: 'rgba(255, 2, 230, 0.08)',
        noteBorderColor: 'rgba(255, 23, 159, 0.35)',
        noteTextColor: token('--fg-2'),
        activationBkgColor: 'rgba(255, 23, 159, 0.18)',
        activationBorderColor: token('--pink-400'),
      },
      securityLevel: 'strict',
    });

    const entries = Array.from(blocks, (block) => {
      const source = (block.textContent ?? '').trim();
      const figure = document.createElement('figure');
      figure.className = 'mermaid-figure';

      const container = document.createElement('div');
      container.className = 'mermaid';
      container.textContent = source;

      // Preserve the linear Mermaid text as a collapsible text alternative.
      const details = document.createElement('details');
      details.className = 'diagram-source';
      const summary = document.createElement('summary');
      summary.textContent = 'Diagram source';
      const pre = document.createElement('pre');
      const code = document.createElement('code');
      code.textContent = source;
      pre.append(code);
      details.append(summary, pre);

      figure.append(container, details);
      return { block, figure, container, label: describeDiagram(source) };
    });

    // Mermaid measures its text; wait for the web font before swapping in
    // the containers, so the source stays visible until the layout is final.
    await document.fonts.ready;
    for (const { block, figure } of entries) block.replaceWith(figure);
    await mermaid.run({ nodes: entries.map((entry) => entry.container) });
    for (const { container, label } of entries) {
      // Mermaid's SVG text nodes sit in layout order rather than reading order;
      // hide the SVG internals behind a labeled role="img" wrapper while the
      // disclosure below carries the full step-by-step source.
      const svg = container.querySelector('svg');
      if (svg) {
        const graphic = document.createElement('div');
        graphic.setAttribute('role', 'img');
        graphic.setAttribute('aria-label', label);
        svg.setAttribute('aria-hidden', 'true');
        svg.replaceWith(graphic);
        graphic.append(svg);
      }
      watchOverflow(container, container, `Scrollable ${label.toLowerCase()}`);
    }
  }
</script>
