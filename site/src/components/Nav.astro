---
import type { NavGroup } from '../lib/collection';
import { withBase } from '../lib/docs';

interface Props {
  groups: NavGroup[];
  currentId: string;
}

const { groups, currentId } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="sidebar" aria-label="Documentation">
  <details class="sidebar-nav" open>
    <summary class="sidebar-nav-toggle">Documentation</summary>
    <div class="sidebar-groups">
      {
        groups.map((group) => (
          <details open>
            <summary>
              <span class="sidebar-group-label">{group.label}</span>
            </summary>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a
                    href={withBase(item.route, base)}
                    aria-current={item.id === currentId ? 'page' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </details>
</nav>

<script>
  // On narrow screens the groups collapse behind one menu; wide screens keep
  // them open. The media query stays in CSS; this only reads its result.
  const menu = document.querySelector<HTMLDetailsElement>('.sidebar-nav');
  const toggle = menu?.querySelector('summary');
  if (menu && toggle) {
    const isMenu = () => getComputedStyle(toggle).display !== 'none';
    menu.open = !isMenu();
    window.addEventListener('resize', () => {
      if (!isMenu()) menu.open = true;
    });
  }
</script>
