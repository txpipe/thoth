---
// GitHub Pages serves this for any path under the site that has no page.
import DocPage from '../layouts/DocPage.astro';
import { getDocs, navGroups } from '../lib/collection';
import { REPO_URL, routeFor, withBase } from '../lib/docs';

const docs = await getDocs();
const groups = navGroups(docs);
const base = import.meta.env.BASE_URL;
const pages = groups
  .flatMap((group) => group.items)
  .map((item) => ({ url: withBase(item.route, base), title: item.pageTitle }));
---

<DocPage title="Page not found" groups={groups} currentId="" headings={[]}>
  <h1>Page not found</h1>
  <p>
    This address isn't a page on the Thoth docs site. The doc may have moved, or the link points at
    a file the site doesn't publish.
  </p>
  <p class="not-found-guess" hidden>Did you mean <a href={withBase('/', base)}></a>?</p>
  <ul>
    <li><button class="link-button" type="button" data-open-search>Search the docs</button></li>
    <li><a href={withBase('/', base)}>Start from the introduction</a></li>
    <li><a href={withBase(routeFor('CONTEXT.md'), base)}>Look a term up in the glossary</a></li>
    <li><a href={REPO_URL}>Browse the repository on GitHub</a></li>
  </ul>
  <script is:inline type="application/json" id="site-pages" set:html={JSON.stringify(pages)} />
</DocPage>

<script>
  // Suggest the page that best matches the address that missed, word by word,
  // and seed search with that page's title, or with the address's words.
  const pages: { url: string; title: string }[] = JSON.parse(
    document.getElementById('site-pages')?.textContent ?? '[]',
  );
  const words = (text: string) =>
    decodeURIComponent(text)
      .toLowerCase()
      .replace(/\.md$|\/$/g, '')
      .split(/[^a-z0-9]+/)
      .filter((word) => word && word !== 'thoth' && word !== 'readme');
  // Edit distance that counts a swap of two neighbours as one edit, so
  // "desing" is one edit from "design".
  const distance = (a: string, b: string) => {
    const rows = Array.from({ length: a.length + 1 }, (_, i) =>
      Array.from({ length: b.length + 1 }, (_, j) => (i === 0 ? j : j === 0 ? i : 0)),
    );
    for (let i = 1; i <= a.length; i += 1) {
      for (let j = 1; j <= b.length; j += 1) {
        const row = rows[i] ?? [];
        const above = rows[i - 1] ?? [];
        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
        row[j] = Math.min((above[j] ?? 0) + 1, (row[j - 1] ?? 0) + 1, (above[j - 1] ?? 0) + cost);
        if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
          row[j] = Math.min(row[j] ?? 0, (rows[i - 2]?.[j - 2] ?? 0) + 1);
        }
      }
    }
    return rows[a.length]?.[b.length] ?? 0;
  };
  // A missed word matches a page word it starts, that starts it, or that is a
  // typo away: one edit for a short word, two for a long one.
  const matches = (missed: string, word: string) =>
    (missed.length >= 3 && word.startsWith(missed)) ||
    (word.length >= 3 && missed.startsWith(word)) ||
    (missed.length >= 4 && distance(missed, word) <= (missed.length >= 7 ? 2 : 1));
  const hits = (missed: string[], candidate: string[]) =>
    missed.filter((word) => candidate.some((other) => matches(word, other))).length;

  const segments = window.location.pathname.split('/').filter(Boolean);
  const last = words(segments.at(-1) ?? '');
  const folders = words(segments.slice(0, -1).join('/'));
  let best: { url: string; title: string } | undefined;
  if (last.length > 0) {
    // The last segment names the page; earlier ones, such as docs/, only break ties.
    const ranked = pages
      .map((page) => {
        const candidate = [
          ...words(new URL(page.url, window.location.origin).pathname),
          ...words(page.title),
        ];
        return { page, own: hits(last, candidate), folder: hits(folders, candidate), size: candidate.length };
      })
      .filter((entry) => entry.own * 2 >= last.length && entry.own > 0)
      .sort((a, b) => b.own - a.own || b.folder - a.folder || a.size - b.size);
    best = ranked[0]?.page;
  }
  const guess = document.querySelector<HTMLElement>('.not-found-guess');
  const link = guess?.querySelector('a');
  if (best && guess && link) {
    link.href = best.url;
    link.textContent = best.title;
    guess.hidden = false;
  }
  const search = document.querySelector<HTMLElement>('[data-open-search].link-button');
  if (search) search.dataset.query = best?.title ?? last.join(' ');
</script>
