---
import type { MarkdownHeading } from 'astro';
import Nav from '../components/Nav.astro';
import type { NavGroup } from '../lib/collection';
import { REPO_URL, withBase } from '../lib/docs';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  groups: NavGroup[];
  currentId: string;
  headings: MarkdownHeading[];
  /** Short docs, such as policy examples: sections open on a tick, not a full rule. */
  compact?: boolean;
}

const { title, groups, currentId, headings, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = withBase('/', base);
const pageTitle = title === 'Thoth' ? 'Thoth' : `${title} · Thoth`;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141011" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={withBase('/favicon.svg', base)} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-brand">
          <a class="wordmark" href={home}>Thoth</a>
          <span class="site-tagline">private N-of-M attestation</span>
        </div>
        <a class="repo" href={REPO_URL}>
          <!-- GitHub mark from Octicons (MIT), https://github.com/primer/octicons -->
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          GitHub
        </a>
      </div>
    </header>
    <div class="site-body">
      <Nav groups={groups} currentId={currentId} />
      <main id="content" class="content prose" data-compact={compact ? '' : undefined}>
        <slot />
      </main>
      {
        toc.length > 0 && (
          <details class="doc-meta" data-menu open>
            <summary class="menu-toggle">On this page</summary>
            <nav aria-label="On this page">
              <p class="doc-toc-title" aria-hidden="true">
                On this page
              </p>
              <ul>
                {toc.map((heading) => (
                  <li class={`depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        )
      }
    </div>
    <p class="visually-hidden" role="status" id="copy-status"></p>
    <footer class="site-footer">
      <span>Copyright 2026 TxPipe</span>
      <span>Apache-2.0 · <a href={`${REPO_URL}/blob/main/LICENSE`}>License</a></span>
    </footer>
    <script>
      import { watchOverflow } from '../lib/overflow';

      // On narrow screens the nav and the table of contents collapse behind a
      // toggle; wide screens keep them open. The breakpoint stays in CSS: a
      // menu is collapsible exactly when its toggle is displayed.
      const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));
      const isCollapsible = (menu: HTMLDetailsElement) => {
        const toggle = menu.querySelector(':scope > summary');
        return toggle !== null && getComputedStyle(toggle).display !== 'none';
      };
      for (const menu of menus) menu.open = !isCollapsible(menu);
      window.addEventListener('resize', () => {
        for (const menu of menus) if (!isCollapsible(menu)) menu.open = true;
      });

      // Mark the section being read: the last heading scrolled past the header.
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.doc-meta a[href^="#"]'),
      );
      const sections = tocLinks.map((link) =>
        document.getElementById(decodeURIComponent(link.hash.slice(1))),
      );
      const header = document.querySelector<HTMLElement>('.site-header');
      let frame = 0;
      const markSection = () => {
        frame = 0;
        const line = (header?.offsetHeight ?? 0) + 32;
        let current = -1;
        sections.forEach((section, index) => {
          if (section && section.getBoundingClientRect().top <= line) current = index;
        });
        tocLinks.forEach((link, index) => {
          if (index === current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      if (tocLinks.length > 0) {
        window.addEventListener(
          'scroll',
          () => {
            if (!frame) frame = requestAnimationFrame(markSection);
          },
          { passive: true },
        );
        markSection();
      }

      // Code blocks get a bar with their language and a copy button, and fade
      // the edge that hides code, so a clipped line reads as scrollable.
      const status = document.getElementById('copy-status');
      const announce = (message: string) => {
        if (status) status.textContent = message;
      };
      const plain = new Set(['plaintext', 'text', 'txt']);
      for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
        if (pre.dataset.language === 'mermaid') continue;
        const block = document.createElement('div');
        block.className = 'code-block';
        const bar = document.createElement('div');
        bar.className = 'code-block-bar';
        const language = document.createElement('span');
        language.className = 'code-block-lang';
        const name = pre.dataset.language ?? '';
        language.textContent = plain.has(name) ? '' : name;
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'code-block-copy';
        copy.textContent = 'Copy';
        let reset: ReturnType<typeof setTimeout> | undefined;
        const flash = (label: string) => {
          copy.textContent = label;
          clearTimeout(reset);
          reset = setTimeout(() => {
            copy.textContent = 'Copy';
          }, 2000);
        };
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '');
            flash('Copied');
            announce('Copied the code to the clipboard.');
          } catch {
            // No clipboard access (an insecure context or a denied permission):
            // select the code so the reader's own copy shortcut works.
            const range = document.createRange();
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            flash('Selected');
            announce('The clipboard is unavailable. The code is selected; copy it with your keyboard.');
          }
        });
        bar.append(language, copy);
        pre.before(block);
        block.append(bar, pre);
        watchOverflow(pre, block);
      }
      for (const table of document.querySelectorAll<HTMLElement>('.prose table')) {
        watchOverflow(table);
      }
    </script>
    <script>
      import { watchOverflow } from '../lib/overflow';

      // Mermaid is imported only on pages that have a diagram; the chunk is large.
      const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (blocks.length > 0) {
        const { default: mermaid } = await import('mermaid');
        const root = getComputedStyle(document.documentElement);
        const token = (name: string) => root.getPropertyValue(name).trim();
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          look: 'classic',
          // Draw the diagram from the site's tokens rather than Mermaid's palette.
          themeVariables: {
            fontFamily: token('--font-sans'),
            fontSize: '15px',
            background: 'transparent',
            primaryColor: token('--bg-card'),
            primaryTextColor: token('--fg-1'),
            primaryBorderColor: token('--stroke-2'),
            secondaryColor: token('--bg-card'),
            tertiaryColor: token('--bg-card'),
            mainBkg: token('--bg-card'),
            nodeBorder: token('--stroke-2'),
            lineColor: token('--stroke-1'),
            textColor: token('--fg-2'),
            edgeLabelBackground: token('--bg-card'),
            actorBkg: token('--bg-card'),
            actorBorder: token('--stroke-2'),
            actorTextColor: token('--fg-1'),
            actorLineColor: token('--stroke-2'),
            signalColor: token('--cyan-100'),
            signalTextColor: token('--fg-2'),
            labelBoxBkgColor: token('--bg-card'),
            labelBoxBorderColor: 'rgba(255, 23, 159, 0.40)',
            labelTextColor: token('--fg-2'),
            loopTextColor: token('--fg-2'),
            noteBkgColor: 'rgba(255, 2, 230, 0.08)',
            noteBorderColor: 'rgba(255, 23, 159, 0.35)',
            noteTextColor: token('--fg-2'),
            activationBkgColor: 'rgba(255, 23, 159, 0.18)',
            activationBorderColor: token('--pink-400'),
          },
          securityLevel: 'strict',
        });
        const nodes = Array.from(blocks, (block) => {
          const container = document.createElement('div');
          container.className = 'mermaid';
          container.textContent = block.textContent;
          return container;
        });
        // Mermaid measures its text; wait for the web font before swapping in
        // the containers, so the source stays visible until the layout is final.
        await document.fonts.ready;
        blocks.forEach((block, index) => block.replaceWith(nodes[index]!));
        await mermaid.run({ nodes });
        for (const node of nodes) watchOverflow(node);
      }
    </script>
  </body>
</html>
