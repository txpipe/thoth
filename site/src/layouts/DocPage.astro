---
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { MarkdownHeading } from 'astro';
import Mermaid from '../components/Mermaid.astro';
import Nav from '../components/Nav.astro';
import Search from '../components/Search.astro';
import { type NavGroup, neighborsOf } from '../lib/collection';
import { REPO_URL, withBase } from '../lib/docs';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  groups: NavGroup[];
  currentId: string;
  headings: MarkdownHeading[];
  /** Short docs, such as policy examples: sections open on a tick, not a full rule. */
  compact?: boolean;
  /** The doc's repo path, for the edit link; pages that aren't docs leave it out. */
  sourcePath?: string;
}

const { title, groups, currentId, headings, compact = false, sourcePath } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = withBase('/', base);
const pageTitle = title === 'Thoth' ? 'Thoth' : `${title} · Thoth`;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const { prev, next } = neighborsOf(groups, currentId);
const contentHtml = await Astro.slots.render('default');
const hasMermaid = contentHtml.includes('data-language="mermaid"');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141011" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={withBase('/favicon.svg', base)} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-brand">
          <a class="wordmark" href={home}>Thoth</a>
          <span class="site-tagline">private N-of-M attestation</span>
        </div>
        <div class="site-actions">
          <Search />
          <a class="repo" href={REPO_URL}>
            <!-- GitHub mark from Octicons (MIT), https://github.com/primer/octicons -->
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              />
            </svg>
            GitHub
          </a>
          <button
            class="menu-button"
            type="button"
            aria-controls="site-menu"
            aria-expanded="false"
            aria-label="Menu"
          >
            <span class="menu-button-bars" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>
    <div class="site-body">
      <!-- Wide screens lay the nav and the contents out as columns; narrow
           screens put both in a drawer behind the header's menu button. -->
      <div class="site-menu" id="site-menu">
        <Nav groups={groups} currentId={currentId} />
        {
          toc.length > 0 && (
            <nav class="doc-meta" aria-label="On this page">
              <p class="doc-toc-title" aria-hidden="true">
                On this page
              </p>
              <ul>
                {toc.map((heading) => (
                  <li class={`depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
      <div class="menu-backdrop" hidden></div>
      <main
        id="content"
        class="content prose"
        data-compact={compact ? '' : undefined}
        data-pagefind-body={sourcePath ? '' : undefined}
      >
        <Fragment set:html={contentHtml} />
        {
          sourcePath && (
            <p class="doc-edit" data-pagefind-ignore>
              <a href={`${REPO_URL}/edit/main/${sourcePath}`}>Edit this page on GitHub</a>
            </p>
          )
        }
        {
          (prev || next) && (
            <nav class="doc-pager" aria-label="Pagination" data-pagefind-ignore>
              {prev && (
                <a class="doc-pager-link prev" href={withBase(prev.route, base)} rel="prev">
                  <span class="doc-pager-label">
                    <svg
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 3.5L6 8l4.5 4.5"
                      />
                    </svg>
                    Previous
                  </span>
                  <span class="doc-pager-title">{prev.pageTitle}</span>
                </a>
              )}
              {next && (
                <a class="doc-pager-link next" href={withBase(next.route, base)} rel="next">
                  <span class="doc-pager-label">
                    Next
                    <svg
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5.5 3.5L10 8l-4.5 4.5"
                      />
                    </svg>
                  </span>
                  <span class="doc-pager-title">{next.pageTitle}</span>
                </a>
              )}
            </nav>
          )
        }
        <p class="visually-hidden" role="status" id="copy-status" data-pagefind-ignore></p>
      </main>
    </div>
    <footer class="site-footer">
      <span>Copyright 2026 TxPipe</span>
      <span>Apache-2.0 · <a href={`${REPO_URL}/blob/main/LICENSE`}>License</a></span>
    </footer>
    <script>
      import { watchOverflow } from '../lib/overflow';

      // Below 78rem the menu button opens a drawer. On laptop widths the nav
      // stays a column and the drawer is the contents (.doc-meta); on phones
      // the drawer is the whole .site-menu. CSS decides which.
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('.menu-button');
      const drawer = document.getElementById('site-menu');
      const backdrop = document.querySelector<HTMLElement>('.menu-backdrop');
      const panel = () =>
        drawer && getComputedStyle(drawer).display === 'contents'
          ? document.querySelector<HTMLElement>('.doc-meta')
          : drawer;
      // While the drawer is open everything else is inert, so Tab stays in it.
      const outside = () =>
        [
          ...document.querySelectorAll<HTMLElement>(
            '.skip, .site-brand, .search-button, .repo, main, .site-footer',
          ),
          ...(panel() === drawer ? [] : document.querySelectorAll<HTMLElement>('.sidebar')),
        ];
      let collapsed = false;
      const setMenu = (open: boolean, { restoreFocus = false } = {}) => {
        if (!button) return;
        const target = panel();
        button.setAttribute('aria-expanded', String(open));
        root.toggleAttribute('data-menu-open', open);
        if (backdrop) backdrop.hidden = !open;
        for (const element of document.querySelectorAll<HTMLElement>('[data-menu-inert]')) {
          element.inert = false;
          delete element.dataset.menuInert;
        }
        if (!open) {
          if (restoreFocus) button.focus();
          return;
        }
        for (const element of outside()) {
          element.inert = true;
          element.dataset.menuInert = '';
        }
        // On a phone the nav and the contents share the drawer: fold the nav
        // groups that don't hold this page, once, so the contents stay close.
        if (drawer && target === drawer && !collapsed) {
          collapsed = true;
          for (const group of drawer.querySelectorAll<HTMLDetailsElement>('.sidebar details')) {
            if (!group.querySelector('[aria-current="page"]')) group.open = false;
          }
        }
        // Land on the section being read, else the current page, else the top.
        const focus =
          target?.querySelector<HTMLElement>('[aria-current="location"]') ??
          target?.querySelector<HTMLElement>('[aria-current="page"]') ??
          target?.querySelector<HTMLElement>('a');
        focus?.focus({ preventScroll: true });
        focus?.scrollIntoView({ block: 'nearest' });
      };
      button?.addEventListener('click', () => {
        setMenu(button.getAttribute('aria-expanded') !== 'true');
      });
      backdrop?.addEventListener('click', () => setMenu(false, { restoreFocus: true }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && root.hasAttribute('data-menu-open')) {
          setMenu(false, { restoreFocus: true });
        }
      });
      // A link in the drawer closes it. A contents link then hands focus to its
      // section, which the hidden link can no longer hold.
      drawer?.addEventListener('click', (event) => {
        const link = (event.target as Element).closest('a');
        if (!link || !root.hasAttribute('data-menu-open')) return;
        setMenu(false);
        if (!link.hash || link.pathname !== window.location.pathname) return;
        const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!section) return;
        requestAnimationFrame(() => {
          if (!section.hasAttribute('tabindex')) section.setAttribute('tabindex', '-1');
          section.focus({ preventScroll: true });
        });
      });
      // The button names what the drawer holds at this width.
      const label = () => button?.setAttribute('aria-label', panel() === drawer ? 'Menu' : 'On this page');
      label();
      // The drawer changes shape at each breakpoint; close it when one is crossed.
      for (const query of ['(max-width: 78rem)', '(max-width: 56rem)']) {
        window.matchMedia(query).addEventListener('change', () => {
          setMenu(false);
          label();
        });
      }

      // Mark the section being read: the last heading scrolled past the header.
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('.doc-meta a[href^="#"]'),
      );
      const sections = tocLinks.map((link) =>
        document.getElementById(decodeURIComponent(link.hash.slice(1))),
      );
      const header = document.querySelector<HTMLElement>('.site-header');
      let frame = 0;
      const markSection = () => {
        frame = 0;
        const line = (header?.offsetHeight ?? 0) + 32;
        let current = -1;
        sections.forEach((section, index) => {
          if (section && section.getBoundingClientRect().top <= line) current = index;
        });
        // Short sections at the end of a page cannot scroll past the top line;
        // mark the last heading once the reader reaches the foot of the document.
        const atBottom =
          window.scrollY > 0 &&
          window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
        if (atBottom) {
          for (let index = sections.length - 1; index >= 0; index -= 1) {
            if (sections[index]) {
              current = index;
              break;
            }
          }
        }
        tocLinks.forEach((link, index) => {
          if (index === current) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      if (tocLinks.length > 0) {
        window.addEventListener(
          'scroll',
          () => {
            if (!frame) frame = requestAnimationFrame(markSection);
          },
          { passive: true },
        );
        markSection();
      }

      // Code blocks get a bar with their language and a copy button, and fade
      // the edge that hides code, so a clipped line reads as scrollable.
      const status = document.getElementById('copy-status');
      const announce = (message: string) => {
        if (status) status.textContent = message;
      };
      const plain = new Set(['plaintext', 'text', 'txt']);
      for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code')) {
        if (pre.dataset.language === 'mermaid') continue;
        const block = document.createElement('div');
        block.className = 'code-block';
        const bar = document.createElement('div');
        bar.className = 'code-block-bar';
        const language = document.createElement('span');
        language.className = 'code-block-lang';
        const name = pre.dataset.language ?? '';
        const visibleLang = plain.has(name) ? '' : name;
        language.textContent = visibleLang;
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'code-block-copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', visibleLang ? `Copy ${visibleLang} code` : 'Copy code');
        let reset: ReturnType<typeof setTimeout> | undefined;
        const flash = (label: string, state: string) => {
          copy.textContent = label;
          copy.dataset.state = state;
          clearTimeout(reset);
          reset = setTimeout(() => {
            copy.textContent = 'Copy';
            delete copy.dataset.state;
          }, 2000);
        };
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '');
            flash('Copied', 'copied');
            announce('Copied the code to the clipboard.');
          } catch {
            // No clipboard access (an insecure context or a denied permission):
            // select the code so the reader's own copy shortcut works.
            const range = document.createRange();
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            flash('Selected', 'copied');
            announce('The clipboard is unavailable. The code is selected; copy it with your keyboard.');
          }
        });
        bar.append(language, copy);
        pre.before(block);
        block.append(bar, pre);
        watchOverflow(pre, block, visibleLang ? `Scrollable ${visibleLang} code` : 'Scrollable code');
      }
      for (const wrap of document.querySelectorAll<HTMLElement>('.prose .table-wrap')) {
        watchOverflow(wrap, wrap, 'Scrollable table');
      }
    </script>
    {hasMermaid && <Mermaid />}
  </body>
</html>
